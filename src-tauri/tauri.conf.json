{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen75",
  "version": "0.1.0",
  "identifier": "io.github.whiskey00.lumen75",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumen75",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "visible": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright (c) 2026 whiskey00. MIT License.",
    "resources": {
      "../LICENSE": "legal/LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "legal/THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
